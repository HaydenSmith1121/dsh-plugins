{
  "name": "dsh-plugins-market",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "dsh-plugins 仓库自带的可视化插件市场：读取仓库里「一个插件一个配置文件」的目录（catalog/plugins/*.json），装了新版本会提示升级、已是最新则禁用安装；带装前兼容性闸门与失败自动回滚的一键安装，安装全程可见进度与预计时间、可随时中止，并始终给出手动安装命令",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "catalog",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "external": []
    },
    "market": {
      "profile": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "market",
    "cordis"
  ],
  "author": "HaydenSmith1121",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaydenSmith1121/dsh-plugins.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "test": "node test/run.mjs",
    "test:smoke": "node test/smoke-server.mjs"
  }
}
